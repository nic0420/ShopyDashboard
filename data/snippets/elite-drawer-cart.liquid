{% comment %}
  Elite Slide-out Cart Drawer with Free Shipping Goal Bar
{% endcomment %}

<style>
  .elite-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    z-index: 99990;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .elite-drawer-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }
  .elite-cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 420px;
    background: #FFFFFF;
    z-index: 99999;
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.2);
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .elite-cart-drawer.is-open {
    transform: translateX(0);
  }
  .elite-drawer-header {
    padding: 18px 22px;
    border-bottom: 1px solid #E2E8F0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .elite-drawer-header h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
    color: #0F172A;
  }
  .elite-drawer-close {
    background: none;
    border: none;
    font-size: 1.3rem;
    color: #64748B;
    cursor: pointer;
    padding: 4px;
  }
  .elite-free-shipping-goal {
    background: #F0FDF4;
    border-bottom: 1px solid #DCFCE7;
    padding: 14px 22px;
    text-align: center;
  }
  .elite-goal-text {
    font-size: 0.84rem;
    font-weight: 700;
    color: #065F46;
    margin-bottom: 8px;
  }
  .elite-goal-bar {
    width: 100%;
    height: 8px;
    background: #DCFCE7;
    border-radius: 9999px;
    overflow: hidden;
  }
  .elite-goal-fill {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #10B981 0%, #059669 100%);
    border-radius: 9999px;
  }
  .elite-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px 22px;
  }
  .elite-cart-item {
    display: flex;
    gap: 14px;
    padding-bottom: 16px;
    border-bottom: 1px solid #F1F5F9;
    margin-bottom: 16px;
  }
  .elite-cart-thumb {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    object-fit: cover;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
  }
  .elite-cart-meta h4 {
    margin: 0 0 4px 0;
    font-size: 0.92rem;
    font-weight: 700;
    color: #1E293B;
  }
  .elite-cart-meta p {
    margin: 0 0 8px 0;
    font-size: 0.88rem;
    font-weight: 800;
    color: #10B981;
  }
  .elite-drawer-footer {
    padding: 20px 22px;
    border-top: 1px solid #E2E8F0;
    background: #F8FAFC;
  }
  .elite-checkout-btn {
    width: 100%;
    background: linear-gradient(135deg, #10B981 0%, #059669 100%);
    color: #FFFFFF;
    border: none;
    font-size: 1rem;
    font-weight: 800;
    padding: 16px;
    border-radius: 12px;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .elite-checkout-btn:hover {
    opacity: 0.95;
    transform: translateY(-1px);
  }
  .elite-secure-lock {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 0.76rem;
    color: #64748B;
    margin-top: 10px;
    font-weight: 600;
  }
</style>

<div id="eliteDrawerOverlay" class="elite-drawer-overlay" onclick="window.closeEliteCartDrawer()"></div>

<div id="eliteCartDrawer" class="elite-cart-drawer">
  <div class="elite-drawer-header">
    <h3>Tu Carrito de Compra</h3>
    <button type="button" class="elite-drawer-close" onclick="window.closeEliteCartDrawer()">✕</button>
  </div>

  <div class="elite-free-shipping-goal">
    <div class="elite-goal-text">🎉 ¡Felicidades! Has desbloqueado <strong>ENVÍO GRATIS ASEGURADO</strong></div>
    <div class="elite-goal-bar">
      <div class="elite-goal-fill"></div>
    </div>
  </div>

  <div class="elite-drawer-body">
    <div class="elite-cart-item">
      <div class="elite-cart-thumb" style="display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">🛍️</div>
      <div class="elite-cart-meta">
        <h4>{{ product.title | default: 'Artículo Seleccionado' }}</h4>
        <p>{{ product.price | default: 36.25 | money }}</p>
        <small style="color: #64748B;">Cantidad: 1 • Calidad Garantizada</small>
      </div>
    </div>
  </div>

  <div class="elite-drawer-footer">
    <button type="button" class="elite-checkout-btn" onclick="window.location.href = '/checkout';">
      <span>🔒 Tramitar Pedido Seguro</span>
    </button>
    <div class="elite-secure-lock">
      <span>🛡️</span> Checkout Seguro con Cifrado SSL de 256 bits
    </div>
  </div>
</div>

<script>
  window.openEliteCartDrawer = function() {
    var drawer = document.getElementById('eliteCartDrawer');
    var overlay = document.getElementById('eliteDrawerOverlay');
    if (drawer && overlay) {
      drawer.classList.add('is-open');
      overlay.classList.add('is-open');
    }
  };

  window.closeEliteCartDrawer = function() {
    var drawer = document.getElementById('eliteCartDrawer');
    var overlay = document.getElementById('eliteDrawerOverlay');
    if (drawer && overlay) {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
    }
  };
</script>
