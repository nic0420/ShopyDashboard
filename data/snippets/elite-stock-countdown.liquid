{% comment %}
  Elite Stock Scarcity & Shipping Countdown Timer (CRO Boost)
{% endcomment %}

<style>
  .elite-urgency-wrapper {
    margin: 18px 0;
    padding: 16px 18px;
    background: #FFFBEB;
    border: 1px solid #FDE68A;
    border-radius: 12px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .elite-stock-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .elite-stock-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: #92400E;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .elite-stock-pulse {
    width: 8px;
    height: 8px;
    background: #EF4444;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
    animation: elitePulse 1.6s infinite cubic-bezier(0.66, 0, 0, 1);
  }
  @keyframes elitePulse {
    to {
      box-shadow: 0 0 0 10px rgba(239, 68, 68, 0);
    }
  }
  .elite-stock-bar-bg {
    width: 100%;
    height: 7px;
    background: #FDE68A;
    border-radius: 9999px;
    overflow: hidden;
    margin-bottom: 12px;
  }
  .elite-stock-bar-fill {
    width: 28%;
    height: 100%;
    background: linear-gradient(90deg, #F59E0B 0%, #EF4444 100%);
    border-radius: 9999px;
    transition: width 0.6s ease;
  }
  .elite-countdown-box {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.84rem;
    color: #78350F;
    font-weight: 600;
  }
  .elite-countdown-digits {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 800;
    color: #B45309;
    background: rgba(245, 158, 11, 0.15);
    padding: 2px 6px;
    border-radius: 4px;
  }
</style>

<div class="elite-urgency-wrapper">
  <div class="elite-stock-header">
    <div class="elite-stock-title">
      <span class="elite-stock-pulse"></span>
      Alta Demanda: Solo quedan <strong style="color: #B91C1C; margin: 0 3px;">7 unidades</strong> en este lote
    </div>
  </div>

  <div class="elite-stock-bar-bg">
    <div class="elite-stock-bar-fill"></div>
  </div>

  <div class="elite-countdown-box">
    <span>📦</span>
    <span>Ordena en los próximos <span class="elite-countdown-digits" id="eliteShippingCountdown">14:48</span> para <strong>Despacho Prioritario Hoy</strong></span>
  </div>
</div>

<script>
  (function() {
    var timerEl = document.getElementById('eliteShippingCountdown');
    if (!timerEl) return;

    var storageKey = 'elite_ship_timer_end';
    var endTime = localStorage.getItem(storageKey);
    var now = new Date().getTime();

    if (!endTime || parseInt(endTime, 10) < now) {
      endTime = now + (15 * 60 * 1000) + (32 * 1000); // 15m 32s
      localStorage.setItem(storageKey, endTime);
    } else {
      endTime = parseInt(endTime, 10);
    }

    function updateTimer() {
      var current = new Date().getTime();
      var remaining = Math.max(0, endTime - current);

      var minutes = Math.floor((remaining / 1000 / 60) % 60);
      var seconds = Math.floor((remaining / 1000) % 60);

      timerEl.textContent = (minutes < 10 ? '0' : '') + minutes + ':' + (seconds < 10 ? '0' : '') + seconds;

      if (remaining <= 0) {
        endTime = new Date().getTime() + (18 * 60 * 1000);
        localStorage.setItem(storageKey, endTime);
      }
    }

    updateTimer();
    setInterval(updateTimer, 1000);
  })();
</script>
